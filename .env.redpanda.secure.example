# Non-production secure Redpanda overlay only.
# Use with: docker compose --env-file .env --env-file .env.redpanda.secure \
#   -f infra/docker/compose.infrastructure.yml \
#   -f infra/docker/compose.redpanda.secure.yml up -d
REDPANDA_ADMIN_USER=index-assist-admin
# Set to 1 only for the first startup of a NEW, empty Redpanda cluster.
# Immediately set to 0 and recreate the broker after bootstrap succeeds.
REDPANDA_BOOTSTRAP_ONCE=1

# The password itself is NOT stored here. Create this owner-only file:
# secrets/redpanda/admin-password (at least 32 chars; must not contain ':').
# Also provision broker/admin certificates and three service password files under secrets/kafka/ and secrets/redpanda/ as listed in docs/deployment/kafka-security.md.
# The Redpanda v26.3.1 container runs as an unprivileged user: chown private
# broker/admin key and password files to the UID/GID reported by:
# docker run --rm --entrypoint id redpandadata/redpanda:v26.3.1
