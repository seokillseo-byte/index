# PostgreSQL backup configuration. Keep the DB URL in a protected runtime secret, not Git.
BACKUP_DATABASE_URL=postgresql://backup_role:REPLACE_ME@postgres:5432/index_assist
BACKUP_OUTPUT_DIR=/secure/backups/index-assist
# Public age X25519 recipients only (comma-separated). Each matching private identity can decrypt.
# Keep identities with separate recovery custodians/offline storage; never commit private identities.
BACKUP_AGE_RECIPIENTS=age1REPLACE_WITH_PRIMARY,age1REPLACE_WITH_RECOVERY
# Legacy single-recipient fallback (used only when BACKUP_AGE_RECIPIENTS is unset):
# BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
# Restore-only variables are supplied only during an approved non-production drill:
# RESTORE_DATABASE_URL=
# RESTORE_DUMP_FILE=/secure/backups/index-assist/example.dump.age
# RESTORE_AGE_IDENTITY_FILE=/secure/keys/index-assist-backup-identity.txt
# RESTORE_CONFIRM_NONPROD=YES
# RESTORE_TARGET_EMPTY=YES
