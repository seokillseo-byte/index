# Target configuration for Redpanda v26.3.1 (current supported release at review time).
# This is a template only. Validate it against the exact broker image before use.
# Provision all certificate/key files out-of-band; never commit private keys.
redpanda:
  # Required to activate SASL authentication for Kafka clients.
  enable_sasl: true
  kafka_api:
    - address: 0.0.0.0
      port: 9092
      name: internal
      authentication_method: sasl
  advertised_kafka_api:
    - address: redpanda
      port: 9092
      name: internal
  kafka_api_tls:
    - name: internal
      enabled: true
      require_client_auth: false
      cert_file: /etc/redpanda/certs/broker.crt
      key_file: /etc/redpanda/certs/broker.key
      truststore_file: /etc/redpanda/certs/ca.crt
  kafka_enable_authorization: true
  # Keep the Admin API loopback-only. It also requires authentication via
  # infra/redpanda/.bootstrap.yaml.example; Kafka SASL does NOT protect it.
  admin:
    - address: 127.0.0.1
      port: 9644
      name: admin
  admin_api_tls:
    - name: admin
      enabled: true
      require_client_auth: false
      cert_file: /etc/redpanda/certs/admin.crt
      key_file: /etc/redpanda/certs/admin.key
      truststore_file: /etc/redpanda/certs/ca.crt
