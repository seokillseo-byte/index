# Example for the pinned Redpanda 24.3.x broker image.
# Provision broker.crt/key and ca.crt out-of-band before mounting this file.
redpanda:
  kafka_api:
    - address: 0.0.0.0
      port: 9092
      name: internal
      authentication_method: sasl
  advertised_kafka_api:
    - address: redpanda
      port: 9092
      name: internal
  kafka_api_tls:
    - name: internal
      enabled: true
      require_client_auth: false
      cert_file: /etc/redpanda/certs/broker.crt
      key_file: /etc/redpanda/certs/broker.key
      truststore_file: /etc/redpanda/certs/ca.crt
  kafka_enable_authorization: true
