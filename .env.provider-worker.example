# Dedicated provider worker uses the restricted runtime database role.
PROVIDER_DATABASE_URL=postgresql://index_assist_runtime:REPLACE_WITH_64_HEX_CHARS@postgres:5432/index_assist
KAFKA_BROKERS=redpanda:9092
PROVIDER_KAFKA_TOPIC=provider.jobs
PROVIDER_KAFKA_GROUP_ID=index-assist-provider-v1
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
BING_OAUTH_CLIENT_ID=
BING_OAUTH_CLIENT_SECRET=

GOOGLE_INSPECTION_DAILY_LIMIT=2000
GOOGLE_INSPECTION_PER_MINUTE_LIMIT=600
# Production: provision a CA certificate that validates the broker certificate and a dedicated SCRAM-SHA-512 identity.
# Keep the password in the protected env file/secret manager; never commit populated values.
KAFKA_TLS_CA_FILE=/run/secrets/kafka/ca.crt
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
