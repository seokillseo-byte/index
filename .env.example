# Copy to .env on the server. Generate secrets with: openssl rand -hex 32
NODE_ENV=production
APP_BASE_URL=https://index-assist.io.vn
CORS_ORIGINS=https://index-assist.io.vn
PORT=4000
POSTGRES_DB=index_assist
POSTGRES_USER=index_assist
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARS
APP_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
RELAY_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
MIGRATION_DATABASE_URL=postgresql://index_assist:REPLACE_WITH_64_HEX_CHARS@127.0.0.1:5432/index_assist
DATABASE_URL=postgresql://index_assist_runtime:REPLACE_WITH_64_HEX_CHARS@postgres:5432/index_assist
OUTBOX_DATABASE_URL=postgresql://index_assist_relay:REPLACE_WITH_64_HEX_CHARS@postgres:5432/index_assist
DATABASE_SSL=false
DB_POOL_MAX=20
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REDIS_PASSWORD=REPLACE_WITH_64_HEX_CHARS
KAFKA_BROKERS=redpanda:9092
OUTBOX_BATCH_SIZE=100
OUTBOX_IDLE_MS=500
CLICKHOUSE_DB=index_analytics
CLICKHOUSE_USER=index_analytics
CLICKHOUSE_PASSWORD=REPLACE_WITH_64_HEX_CHARS
MINIO_ROOT_USER=indexassist
MINIO_ROOT_PASSWORD=REPLACE_WITH_64_HEX_CHARS
OPENAPI_ENABLED=false
