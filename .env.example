# Host-side infrastructure secrets. Never pass this entire file into app containers.
# Generate each secret independently with: openssl rand -hex 32
POSTGRES_DB=index_assist
POSTGRES_USER=index_assist
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARS
APP_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
RELAY_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
MIGRATION_DATABASE_URL=postgresql://index_assist:REPLACE_WITH_64_HEX_CHARS@127.0.0.1:5432/index_assist
REDIS_PASSWORD=REPLACE_WITH_64_HEX_CHARS
CLICKHOUSE_DB=index_analytics
CLICKHOUSE_USER=index_analytics
CLICKHOUSE_PASSWORD=REPLACE_WITH_64_HEX_CHARS
MINIO_ROOT_USER=indexassist
MINIO_ROOT_PASSWORD=REPLACE_WITH_64_HEX_CHARS
