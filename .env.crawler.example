DATABASE_URL=postgresql://index_assist_runtime:REPLACE_WITH_64_HEX_CHARS@postgres:5432/index_assist
KAFKA_BROKERS=redpanda:9092
KAFKA_TOPIC=url.ingestion
KAFKA_GROUP_ID=index-assist-crawler-v1
PORT=8080
# Production: provision a CA certificate that validates the broker certificate and a dedicated SCRAM-SHA-512 identity.
# Keep the password in the protected env file/secret manager; never commit populated values.
KAFKA_TLS_CA_FILE=/run/secrets/kafka/ca.crt
KAFKA_SASL_MECHANISM=scram-sha-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
