NODE_ENV=production
APP_BASE_URL=https://index-assist.io.vn
CORS_ORIGINS=https://index-assist.io.vn
PORT=4000
DATABASE_URL=postgresql://index_assist_runtime:REPLACE_WITH_64_HEX_CHARS@postgres:5432/index_assist
DATABASE_SSL=false
DB_POOL_MAX=20

# Required shared Redis storage for API throttling (fail closed if unavailable)
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379/0
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OPENAPI_ENABLED=false

# Search provider OAuth (register exact redirect URIs in provider consoles)
OAUTH_STATE_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
INTEGRATION_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://index-assist.io.vn/api/v1/integrations/google_search_console/callback
BING_OAUTH_CLIENT_ID=
BING_OAUTH_CLIENT_SECRET=
BING_OAUTH_REDIRECT_URI=https://index-assist.io.vn/api/v1/integrations/bing_webmaster/callback

GOOGLE_INSPECTION_DAILY_LIMIT=2000
GOOGLE_INSPECTION_PER_MINUTE_LIMIT=600

# Transactional email (Resend REST API)
RESEND_API_KEY=
EMAIL_FROM=Index Assist <no-reply@index-assist.io.vn>
